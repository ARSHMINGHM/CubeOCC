`timescale 1ns/1ps

// This module is SYNTHESIZABLE. It converts raw DVP camera signals
// into a standard AXI4-Stream video interface to feed the HLS pipeline.
module dvp_to_axis (
    input  logic        pclk,        // Camera Pixel Clock
    input  logic        rst_n,       // Async reset (active low)
    
    // DVP Camera Inputs
    input  logic        vsync,       // Frame valid (1=blanking, 0=active frame)
    input  logic        href,        // Line valid (1=active pixel data)
    input  logic [7:0]  pixel_data,  // Raw 8-bit pixel data
    
    // AXI4-Stream Master Outputs
    output logic [7:0]  m_axis_tdata,
    output logic        m_axis_tvalid,
    input  logic        m_axis_tready, // Driven by downstream HLS IP
    output logic        m_axis_tlast,  // End of line
    output logic        m_axis_tuser   // Start of frame
);

    // We delay signals by 1 clock to safely detect edges (like end of line)
    logic href_d;
    logic vsync_d;
    logic [7:0] data_d;
    logic sof_detected;

    always_ff @(posedge pclk or negedge rst_n) begin
        if (!rst_n) begin
            href_d <= 1'b0;
            vsync_d <= 1'b1; // Default high (blanking)
            data_d <= 8'd0;
            sof_detected <= 1'b0;
        end else begin
            href_d <= href;
            vsync_d <= vsync;
            data_d <= pixel_data;
            
            // Detect Start of Frame (falling edge of vsync: 1 -> 0)
            if (vsync_d == 1'b1 && vsync == 1'b0) begin
                sof_detected <= 1'b1;
            end
            
            // Clear SOF after the first valid pixel is sent
            if (m_axis_tvalid && m_axis_tready && m_axis_tuser) begin
                sof_detected <= 1'b0;
            end
        end
    end

    // AXI-Stream assignments
    // tvalid is high when delayed href is high (meaning data is valid)
    assign m_axis_tvalid = href_d;
    assign m_axis_tdata  = data_d;
    
    // tlast is high on the last pixel of a line
    // (current href is high, but the NEXT href will be low)
    assign m_axis_tlast  = (href_d == 1'b1 && href == 1'b0);
    
    // tuser is high only for the very first pixel of the frame
    assign m_axis_tuser  = sof_detected && href_d;

endmodule
</file>

<file path="rtl/i2c_master.sv">
`timescale 1ns/1ps

// Fully Standard I2C Master with inout SDA and ACK handling.
module i2c_master #(
    parameter SYS_CLK_FREQ = 100_000_000,
    parameter I2C_CLK_FREQ = 400_000
)(
    input  logic        clk,
    input  logic        rst_n,
    input  logic        start,
    input  logic [15:0] reg_addr,
    input  logic [15:0] reg_data,
    output logic        done,
    output logic        scl,
    inout               sda
);

    localparam CLK_DIV = SYS_CLK_FREQ / (I2C_CLK_FREQ * 4);
    localparam SLAVE_ADDR = 8'h78;

    typedef enum logic [3:0] {
        IDLE,
        START,
        SEND_BIT,
        WAIT_HIGH,
        STOP_LOW,
        STOP_HIGH,
        DONE_STATE
    } state_e;

    state_e state;
    logic [15:0] clk_cnt;
    logic [3:0]  bit_cnt; 
    logic [7:0]  shift_reg;
    logic [7:0]  data_arr [0:4];
    logic [2:0]  byte_idx;
    
    logic sda_o;
    logic sda_oe;
    assign sda = sda_oe ? sda_o : 1'bz;

    always_ff @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            state <= IDLE;
            done <= 0;
            scl <= 1;
            sda_o <= 1;
            sda_oe <= 0;
            clk_cnt <= 0;
            bit_cnt <= 0;
            shift_reg <= 0;
            byte_idx <= 0;
        end else begin
            case (state)
                IDLE: begin
                    done <= 0;
                    scl <= 1;
                    sda_o <= 1;
                    sda_oe <= 0; // High-Z
                    clk_cnt <= 0;
                    if (start) begin
                        data_arr[0] <= SLAVE_ADDR;
                        data_arr[1] <= reg_addr[15:8];
                        data_arr[2] <= reg_addr[7:0];
                        data_arr[3] <= reg_data[15:8];
                        data_arr[4] <= reg_data[7:0];
                        byte_idx <= 0;
                        shift_reg <= SLAVE_ADDR;
                        state <= START;
                    end
                end

                START: begin
                    sda_oe <= 1;
                    sda_o <= 0; // SDA goes low while SCL is high (Start)
                    if (clk_cnt == CLK_DIV/2 - 1) begin
                        scl <= 0; // Pull SCL low
                        clk_cnt <= 0;
                        bit_cnt <= 0;
                        state <= SEND_BIT;
                    end else begin
                        clk_cnt <= clk_cnt + 1;
                    end
                end

                SEND_BIT: begin
                    sda_oe <= 1;
                    if (clk_cnt == 0) begin
                        if (bit_cnt < 8) begin
                            sda_o <= shift_reg[7];
                            shift_reg <= shift_reg << 1;
                        end else begin
                            sda_oe <= 0; // Release SDA for ACK
                            sda_o <= 1;
                        end
                    end
                    
                    if (clk_cnt == CLK_DIV - 1) begin
                        clk_cnt <= 0;
                        scl <= 1; // SCL goes high
                        state <= WAIT_HIGH;
                    end else begin
                        clk_cnt <= clk_cnt + 1;
                    end
                end

                WAIT_HIGH: begin
                    if (clk_cnt == CLK_DIV - 1) begin
                        clk_cnt <= 0;
                        scl <= 0; // SCL goes low
                        if (bit_cnt == 8) begin
                            // ACK bit just finished
                            bit_cnt <= 0;
                            if (byte_idx < 4) begin
                                byte_idx <= byte_idx + 1;
                                shift_reg <= data_arr[byte_idx + 1];
                                state <= SEND_BIT;
                            end else begin
                                state <= STOP_LOW;
                            end
                        end else begin
                            bit_cnt <= bit_cnt + 1;
                            state <= SEND_BIT;
                        end
                    end else begin
                        clk_cnt <= clk_cnt + 1;
                    end
                end

                STOP_LOW: begin
                    sda_oe <= 1;
                    if (clk_cnt == 0) begin
                        sda_o <= 0;
                    end
                    if (clk_cnt == CLK_DIV - 1) begin
                        clk_cnt <= 0;
                        scl <= 1; // SCL goes high
                        state <= STOP_HIGH;
                    end else begin
                        clk_cnt <= clk_cnt + 1;
                    end
                end

                STOP_HIGH: begin
                    if (clk_cnt == 0) begin
                        sda_o <= 1; // SDA goes high (Stop condition)
                    end
                    if (clk_cnt == CLK_DIV - 1) begin
                        clk_cnt <= 0;
                        state <= DONE_STATE;
                    end else begin
                        clk_cnt <= clk_cnt + 1;
                    end
                end

                DONE_STATE: begin
                    done <= 1;
                    state <= IDLE;
                end
            endcase
        end
    end

endmodule
</file>

